package com.sweettooth.catering.service;

import com.sweettooth.catering.entity.Order;
import com.sweettooth.catering.entity.ContactMessage;
import com.sweettooth.catering.repository.OrderRepository;
import com.sweettooth.catering.repository.ContactRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class CateringService {
    
    @Autowired
    private OrderRepository orderRepository;
    
    @Autowired
    private ContactRepository contactRepository;
    
    public Order saveOrder(Order order) {
        return orderRepository.save(order);
    }
    
    public ContactMessage saveContactMessage(ContactMessage contact) {
        return contactRepository.save(contact);
    }
    
    public long getTotalOrders() {
        return orderRepository.count();
    }
    
    public long getTotalContacts() {
        return contactRepository.count();
    }
}
